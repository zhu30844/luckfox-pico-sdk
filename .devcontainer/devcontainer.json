{
    "name": "LuckfoxPico-MotionSense",
    "build": {
        "dockerfile": "Dockerfile",
        // Locale, timezone, Go and Node versions. Changing any of these needs a
        // "Dev Containers: Rebuild Container" to take effect.
        "args": {
            "LANG": "C.UTF-8",
            "TZ": "Australia/Perth",
            "GO_VERSION": "1.27.3",
            "NODE_VERSION": "26.13.1"
        }
    },
    // GitHub CLI. A feature rather than a Dockerfile line: CI builds that
    // Dockerfile directly and does not need gh.
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash",
                // Nothing in here serves the host: the board is reached
                // outward (adb, ssh). The only listeners are VS Code's and
                // extensions' own, on ports that change every session, so
                // auto-forward plus restore piled up dozens of dead entries.
                // Forward by hand from the Ports panel when needed.
                "remote.autoForwardPorts": false,
                "remote.restoreForwardedPorts": false
            },
            "extensions": [ "Erol444.adb-files",
                            "ms-vscode.cpptools",
                            "ms-vscode.cpptools-extension-pack",
                            "ms-vscode.makefile-tools",
                            "ms-vscode.cmake-tools",
                            "ms-vscode.cpptools-themes",
                            "golang.go",
                            "Vue.volar",
                            "github.vscode-github-actions",
                            "Anthropic.claude-code",
                            "google.geminicodeassist"]
        }
    },
    // Run as dev, remapped to the host user's UID/GID
    "remoteUser": "dev",
    "updateRemoteUserUID": true,
    "runArgs": ["--privileged",
                "-v","/dev:/dev"
            ],
    // Keep the Claude Code and gh logins across rebuilds, both under one host
    // dir. The host dirs are created first, as the host user: if a source
    // were missing, Docker would create it as root. VS Code forwards the SSH
    // agent but not gh's token, so gh needs its own dir; not the host's
    // ~/.config/gh, whose token usually sits in the host keyring rather than
    // in the file.
    "initializeCommand": "mkdir -p \"${localEnv:HOME}/.MotionSense-identity/claude\" \"${localEnv:HOME}/.MotionSense-identity/gh\"",
    "mounts": [
        "source=${localEnv:HOME}/.MotionSense-identity/claude,target=/home/dev/.claude,type=bind",
        "source=${localEnv:HOME}/.MotionSense-identity/gh,target=/home/dev/.gh,type=bind"
    ],
    // Paths are derived from ${containerWorkspaceFolder} so renaming the
    // repo directory cannot desync them. LF_ matches the prefix the SDK's
    // own board configs use.
    "containerEnv": {
        // Puts .claude.json inside the mounted dir too
        "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
        // A mount at ~/.config/gh could leave ~/.config itself root-owned
        "GH_CONFIG_DIR": "/home/dev/.gh",
        "LF_SDK": "${containerWorkspaceFolder}",
        "LF_TOOLCHAIN": "${containerWorkspaceFolder}/tools/linux/toolchain/arm-rockchip830-linux-uclibcgnueabihf",
        "LF_SYSROOT": "${containerWorkspaceFolder}/sysdrv/source/buildroot/buildroot-2023.02.6/output/host/arm-buildroot-linux-uclibcgnueabihf/sysroot",
        "LF_INCLUDE": "${containerWorkspaceFolder}/sysdrv/source/buildroot/buildroot-2023.02.6/output/host/arm-buildroot-linux-uclibcgnueabihf/sysroot/usr/include",
        "LF_LIB": "${containerWorkspaceFolder}/sysdrv/source/buildroot/buildroot-2023.02.6/output/host/arm-buildroot-linux-uclibcgnueabihf/sysroot/usr/lib"
    },
    // Greeting: fixed parts on create, changing parts on start
    "postCreateCommand": {
        "path": "echo 'export PATH=$LF_TOOLCHAIN/bin:$PATH' >> ~/.bashrc",
        // Claude Code CLI into ~/.local/bin; dev-only, so not in the CI image
        "claude": "curl -fsSL https://claude.ai/install.sh | bash && echo 'export PATH=$HOME/.local/bin:$PATH' >> ~/.bashrc",
        "motd": "bash .devcontainer/motd-gen.sh"
    },
    "postStartCommand": "bash .devcontainer/motd-gen.sh --start"
}
