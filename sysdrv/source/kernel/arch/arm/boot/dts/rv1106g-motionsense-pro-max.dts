// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * MotionSense — Luckfox Pico Pro Max carrier.
 *
 * Hardware is the stock Pro Max, so this only includes the vendor dtsi and
 * overrides what this product needs. Keeping it as a separate file means the
 * vendor's rv1106g-luckfox-pico-pro-max.dts never has to be edited, so
 * syncing upstream cannot conflict.
 *
 * Adding a .dts here needs no Makefile change: the kernel is built with
 * `make <name>.img`, which resolves through the generic %.dtb pattern rule.
 * None of the vendor luckfox dts files are listed in the dts Makefile either.
 */

/dts-v1/;

#include "rv1106.dtsi"
#include "rv1106-evb.dtsi"
#include "rv1106-luckfox-pico-pro-max-ipc.dtsi"

/ {
	model = "MotionSense (Luckfox Pico Pro Max)";
	compatible = "rockchip,rv1103g-38x38-ipc-v10", "rockchip,rv1106g3";
};

/**********FLASH**********/
&sfc {
	status = "okay";
	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <75000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

/**********SDMMC**********/
/*
 * The vendor Pro Max dts spells this property "max-freqency", so it is
 * ignored and the controller inherits max-frequency = <200000000> from
 * rv1106.dtsi. Spelled correctly here. no-1-8-v keeps SD/SDIO at 50MHz
 * regardless, so this is about the property doing what it says.
 */
&sdmmc {
	max-frequency = <50000000>;
	no-mmc;
	bus-width = <4>;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	disable-wp;

	//sdio
	cap-sdio-irq;
	/*
	 * non-removable is deliberately not set, unlike the vendor dts.
	 *
	 * That property comes from the reference design, where this slot holds
	 * an SDIO wifi module. Here it holds a removable SD card that the
	 * recordings live on, so card-detect has to be live: with
	 * non-removable the core scans once at probe, ignores the CD pin, and
	 * never retries.
	 *
	 * That is not theoretical. On this board the card times out at the
	 * first probe frequency and only answers on the retry:
	 *   400kHz -> error -110 whilst initialising SD card
	 *   300kHz -> new high speed SDXC card at address 59b4
	 * With non-removable, a boot-time failure was permanent and reseating
	 * the card produced no event at all.
	 */
	no-1-8-v;
	supports-sdio;

	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_clk &sdmmc0_cmd &sdmmc0_det &sdmmc0_bus4>;
	status = "okay";
};

/**********ETH**********/
&gmac {
	status = "okay";
};

/**********USB**********/
&u2phy {
	status = "okay";
};

&u2phy_otg {
	rockchip,dis-u2-susphy;
	status = "okay";
};

&usbdrd {
	status = "okay";
};

&usbdrd_dwc3 {
	status = "okay";
	dr_mode = "peripheral";
};

/**********RTC**********/
&rtc {
	status = "okay";
};

/**********WATCHDOG**********/
/* Idle until something opens /dev/watchdog. */
&wdt {
	status = "okay";
};

/**********BASEBOARD**********/
/*
 * What the MotionSense baseboard (project/app/motionsense/hardware/
 * promax-baseboard) hangs on the 40-pin header. Without the baseboard these
 * are idle controllers on open pins.
 *
 * The vendor dtsi gives several of these controllers two pin groups at once.
 * Each is narrowed here to the group on the header pin the baseboard uses,
 * because the other group lands on a pin with another job:
 *   i2c3  m0 is GPIO2_A6/A7, and A6 is the card-detect line
 *   pwm10 m2 is GPIO1_D1, UART3 RX
 *   pwm11 m2 is GPIO1_D3, I2C3 SCL
 */

/* The vendor's example DHT11 claims GPIO1_C7, which is PWM11 (tilt servo). */
/ {
	/delete-node/ dht11_sensor;
};

/* Head OLED, header pins 11 and 17. */
&i2c1 {
	status = "okay";
};

/* RTC 0x68, address EEPROM 0x50, humidity sensor 0x44; pins 9 and 10. */
&i2c3 {
	pinctrl-0 = <&i2c3m1_xfer>;
	status = "okay";
};

/* Pan servo, pin 5. */
&pwm10 {
	pinctrl-0 = <&pwm10m1_pins>;
	status = "okay";
};

/* Tilt servo, pin 4. */
&pwm11 {
	pinctrl-0 = <&pwm11m1_pins>;
	status = "okay";
};

/* Spare serial header, pins 19 and 20. */
&uart3 {
	status = "okay";
};

/*
 * Second card slot, pins 21, 22 and 24-27, detect on pin 29. The detect
 * switch closes to ground with a card in; the pull-up makes a bare Pro Max
 * read "no card" instead of probing an empty bus.
 */
&sdio {
	max-frequency = <50000000>;
	no-sdio;
	no-mmc;
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	no-1-8-v;
	cd-gpios = <&gpio2 RK_PA6 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc1m0_cmd &sdmmc1m0_clk &sdmmc1m0_bus4 &baseboard_card_det>;
	status = "okay";
};

&pinctrl {
	baseboard {
		baseboard_card_det: baseboard-card-det {
			rockchip,pins = <2 RK_PA6 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};
